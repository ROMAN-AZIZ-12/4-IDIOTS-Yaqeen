# Backend environment; enter values in workspace Secrets, never commit actual values.
# local or production
ENV=
# Existing external Supabase Session pooler, postgresql+psycopg scheme, port 5432
DATABASE_URL=
# Existing Supabase service URL
SUPABASE_URL=
# Backend-only storage credential
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket name
STORAGE_BUCKET=
# Backend-only AI credential (no AI calls in Phase 1)
GEMINI_API_KEY=
# Explicit pinned model name, never a latest alias
GEMINI_MODEL=
# Future authentication signing secret
JWT_SECRET=
# Access token lifetime in minutes
ACCESS_TOKEN_MINUTES=
# Pending token lifetime in minutes
PENDING_TOKEN_MINUTES=
# Future encryption key
FERNET_KEY=
# Exactly one frontend HTTP origin
FRONTEND_ORIGIN=
# Seed only, bcrypt password of 8-72 UTF-8 bytes
SEED_PASSWORD=
# Optional preview listener port
PORT=
